# [필수] HoYoLAB 쿠키 문자열
# 웹 브라우저(F12 개발자도구 -> Application -> Cookies -> act.hoyolab.com)에서 확인
# 필수 포함 항목: ltoken_v2, ltuid_v2 (또는 account_id_v2, cookie_token_v2)
# 형식 예시: HOYOLAB_COOKIES="ltoken_v2=v2_xxxx; ltuid_v2=12345678;"
HOYOLAB_COOKIES="ltoken_v2=your_ltoken_v2_here; ltuid_v2=your_ltuid_v2_here;"

# [선택] 언어 설정 (기본값: ko-kr, 지원: ko-kr, en-us, ja-jp 등)
HOYOLAB_LANG="ko-kr"

# [선택] Discord 알림 Webhook URL (비워두면 콘솔 로그만 출력)
DISCORD_WEBHOOK_URL=""
